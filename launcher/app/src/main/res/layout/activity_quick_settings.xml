<?xml version="1.0" encoding="utf-8"?>
<!-- Control Center (My System TV), as in the preview: glass modules on a four-column grid at the top right, under
     the Settings button, built by QuickSettingsActivity. The Fondo pill turns the panel into the background picker. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">
    <!-- No clipping here either: a focused module grows 4% past the panel's edge, and clipped there its rounded
         corners came out square. -->

    <FrameLayout
        android:id="@+id/panel"
        android:layout_width="186dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="78dp"
        android:layout_marginEnd="44dp"
        android:clipChildren="false"
        android:clipToPadding="false" />
</FrameLayout>
